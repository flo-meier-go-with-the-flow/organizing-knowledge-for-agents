# OpenAI (or an OpenAI-compatible company endpoint, e.g. Azure's v1 API:
# https://<resource>.openai.azure.com/openai/v1/ with the deployment name as the model)
OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Embeddings: an NVIDIA NIM serving Nemotron Embed (OpenAI-compatible /v1/embeddings).
# Self-hosted NIM: http://<host>:8000/v1 (no key needed). NVIDIA hosted trial: https://integrate.api.nvidia.com/v1 + NVIDIA API key.
EMBED_BASE_URL=
EMBED_API_KEY=
# EMBED_MODEL=nvidia/nemotron-3-embed-1b   # check GET <EMBED_BASE_URL>/models for the served ID

# Defaults shown; only set to override.
# ERB_ROOT=../EnterpriseRAG-Bench   # questions + evaluator
# CONFLUENCE_DIR=./data/confluence
# CHROMA_DIR=./data/chroma
# RUNS_DIR=./runs
