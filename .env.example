# OpenAI (or an OpenAI-compatible company endpoint, e.g. Azure's v1 API:
# https://<resource>.openai.azure.com/openai/v1/ with the deployment name as the model)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://foundryagenticretrieval.services.ai.azure.com/openai/v1/

# Embeddings: text-embedding-3-large on the same endpoint as the agent by default.
# Set these only if embeddings live on a different endpoint (on Azure, EMBED_MODEL is the deployment name).
# EMBED_BASE_URL=
# EMBED_API_KEY=
# EMBED_MODEL=text-embedding-3-large

# Judge model for evaluate.py: pin one for the whole study, and don't reuse the agent model.
JUDGE_MODEL=

# Defaults shown; only set to override.
# CONFLUENCE_DIR=./data/confluence
# QUESTIONS_DIR=./data/questions
# CHROMA_DIR=./data/chroma
# RUNS_DIR=./runs
